{
  "manifest_version": 3,
  "name": "StudySaber Extension",
  "version": "1.0.0",
  "description": "Active Recall but its Beatsaber",
  "action": {
    "default_title": "Open Side Panel",
    "default_icon": {
      "16": "vite.svg",
      "48": "vite.svg",
      "128": "vite.svg"
    }
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "side_panel": {
    "default_path": "extension/popup.html"
  },
  "permissions": ["sidePanel", "storage"]
}
